<?xml version="1.0" encoding="utf-8"?>
<!-- Fila del selector de niveles -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/spacing_small"
    android:background="@drawable/bg_level_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/spacing_medium">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/levelNumberText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="casual"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_item_title"
            android:textStyle="bold"
            tools:text="Nivel 1" />

        <TextView
            android:id="@+id/levelWordText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_item_body"
            tools:text="Palabra: ENTI" />

        <TextView
            android:id="@+id/levelLettersText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_item_body"
            tools:text="Letras: 4" />

    </LinearLayout>

    <ImageView
        android:id="@+id/difficultyImage"
        android:layout_width="@dimen/difficulty_image_size"
        android:layout_height="@dimen/difficulty_image_size"
        android:layout_marginStart="@dimen/spacing_medium"
        android:scaleType="fitCenter"
        tools:ignore="ContentDescription"
        tools:src="@drawable/img_difficulty_easy" />

</LinearLayout>
