<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="?attr/colorSurface"
        app:title="Ahorcado"
        app:menu="@menu/topbar_menu"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Todo el contenido va en un ScrollView: en horizontal se puede desplazar en vez de solaparse -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Contenedor del Ahorcado -->
            <FrameLayout
                android:id="@+id/hangmanContainer"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_marginTop="16dp">

                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/hangman_base" />

                <ImageView android:id="@+id/img_hangman_0" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/hangman_0" android:visibility="invisible" />
                <ImageView android:id="@+id/img_hangman_1" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/hangman_1" android:visibility="invisible" />
                <ImageView android:id="@+id/img_hangman_2" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/hangman_2" android:visibility="invisible" />
                <ImageView android:id="@+id/img_hangman_3" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/hangman_3" android:visibility="invisible" />
                <ImageView android:id="@+id/img_hangman_4" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/hangman_4" android:visibility="invisible" />
                <ImageView android:id="@+id/img_hangman_5" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/hangman_5" android:visibility="invisible" />
            </FrameLayout>

            <!-- Palabra: ocupa el espacio libre (centrada entre ahorcado y teclado, como en vertical) -->
            <TextView
                android:id="@+id/wordTextView"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="64dp"
                android:layout_marginHorizontal="16dp"
                android:gravity="center"
                android:letterSpacing="0.2"
                android:textColor="@android:color/black"
                android:textSize="32sp"
                android:textStyle="bold" />

            <!-- Teclado -->
            <GridLayout
                android:id="@+id/keyboardLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:columnCount="7" />
        </LinearLayout>
    </ScrollView>

    <!-- Capa invisible que se activa al final para detectar el tap y salir -->
    <View
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>