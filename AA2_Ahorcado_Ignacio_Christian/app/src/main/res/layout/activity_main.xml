<?xml version="1.0" encoding="utf-8"?>
<!-- Generado con asistencia de IA (Claude) -->
<!-- Splash screen: título, imagen y aviso de "tap para continuar" en la parte inferior -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_large"
        android:fontFamily="casual"
        android:text="@string/app_name"
        android:textColor="@color/ink"
        android:textSize="@dimen/text_title"
        android:textStyle="bold" />

    <!-- Ocupa todo el espacio libre para adaptarse a portrait y landscape -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/spacing_medium"
        android:layout_weight="1"
        android:adjustViewBounds="true"
        android:contentDescription="@string/splash_image_description"
        android:scaleType="fitCenter"
        android:src="@drawable/img_splash" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_large"
        android:fontFamily="casual"
        android:text="@string/tap_to_continue"
        android:textColor="@color/accent"
        android:textSize="@dimen/text_subtitle"
        android:textStyle="bold" />

</LinearLayout>
